# ============================================================
# AMAN MINZ PORTFOLIO — .env.example
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# Server
PORT=3001

# CORS — set to your frontend URL in production
# e.g. https://amanminz.dev
CLIENT_ORIGIN=*

# Project live/GitHub URLs (override the defaults in server.js)
ACHIVER_LIVE_URL=https://achiver.vercel.app
ACHIVER_GITHUB_URL=https://github.com/amanminz/achiver

EVENT_LIVE_URL=https://college-events.vercel.app
EVENT_GITHUB_URL=https://github.com/amanminz/event-management

HACK_GITHUB_URL=https://github.com/amanminz/hackomania-2k25

# Optional: Email service (Nodemailer)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# CONTACT_TO=amanminz.cs@gmail.com
